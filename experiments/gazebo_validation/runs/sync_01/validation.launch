<launch><arg name="gui" default="false" /><arg name="rviz" default="false" /><param name="/use_sim_time" value="true" type="bool" /><param name="/gazebo_validation/enabled" value="true" type="bool" /><param name="robot_description" textfile="/home/l/remani_ws/experiments/gazebo_validation/runs/sync_01/robot.urdf" /><include file="$(find gazebo_ros)/launch/empty_world.launch"><arg name="world_name" value="/home/l/remani_ws/src/mm_gazebo/world/world_2.world" /><arg name="paused" value="true" /><arg name="use_sim_time" value="true" /><arg name="gui" value="$(arg gui)" /></include><node pkg="gazebo_ros" type="spawn_model" name="spawn_mm_robot" args="-param robot_description -urdf -model mm_robot -x 0 -y 0 -z 0.115 -unpause -J joint1 0.0 -J joint2 0.5209807817203074 -J joint3 -1.048907973863552 -J joint4 -3.490658503988659e-05 -J joint5 0.9472949048124424 -J joint6 5.235987755982989e-05 -J joint7 0 -J joint8 0" output="log" /><rosparam file="/home/l/remani_ws/src/mm_gazebo/config/piper_gazebo_control.yaml" command="load" ns="/gazebo" /><node pkg="controller_manager" type="spawner" name="controller_spawner" ns="/gazebo" args="joint_state_controller fr_wheel_velocity_controller fl_wheel_velocity_controller bl_wheel_velocity_controller br_wheel_velocity_controller joint1_position_controller joint2_position_controller joint3_position_controller joint4_position_controller joint5_position_controller joint6_position_controller joint7_position_controller joint8_position_controller" output="log" /><node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"><remap from="joint_states" to="/gazebo/joint_states" /></node><node pkg="mm_remani" type="filter_joint_states.py" name="filter_joint_states" ns="/" output="log" /><node pkg="remani_planner" type="remani_planner_node" name="remani_planner_node" ns="/" output="log"><remap from="~gripper_cmd" to="/mm_controller_node/gripper_cmd" /><remap from="~gripper_state" to="/mm/mani/gripper_state" /><remap from="~odom_world" to="/odom" /><remap from="~joint_state" to="/mm/joint_states" /><remap from="~planning/trajectory" to="planning/trajectory" /><remap from="~planning/start" to="planning/start" /><remap from="~planning/finish" to="planning/finish" /><remap from="~planning/data_display" to="planning/data_display" /><remap from="~grid_map/odom" to="/odom" /><remap from="~grid_map/cloud" to="/velodyne_points" /><remap from="~grid_map/pose" to="pcl_render_node/camera_pose" /><remap from="~grid_map/depth" to="pcl_render_node/depth" /></node><node pkg="mm_controller" type="mm_controller_node" name="mm_controller_node" ns="/" output="log"><remap from="~odom" to="/odom" /><remap from="~joint_states" to="/mm/joint_states" /><remap from="~joint_cmd" to="/mm_controller_node/joint_cmd" /><remap from="~planning/trajectory" to="planning/trajectory" /><remap from="~planning/start" to="planning/start" /><remap from="~planning/finish" to="planning/finish" /></node><node pkg="mm_remani" type="real_base_tracker.py" name="real_base_tracker" ns="/" output="log"><remap from="/cmd_vel" to="/sim/cmd_vel" /></node><node pkg="nodelet" type="nodelet" name="pcl_manager_filter" ns="/" output="log" args="manager" /><node pkg="nodelet" type="nodelet" name="passthrough_z" ns="/" output="log" args="load pcl/PassThrough pcl_manager_filter"><remap from="~input" to="/sim/lidar_raw" /><remap from="~output" to="/livox/lidar_no_ground" /></node><node pkg="nodelet" type="nodelet" name="crop_box_filter" ns="/" output="log" args="load pcl/CropBox pcl_manager_filter"><remap from="~input" to="/livox/lidar_no_ground" /><remap from="~output" to="/velodyne_points" /></node><node pkg="mm_remani" type="dynamic_obstacle_tracker_node" name="dynamic_obstacle_tracker" ns="/" output="log" /><rosparam file="/home/l/remani_ws/experiments/gazebo_validation/runs/sync_01/real_profile.yaml" command="load" /><node pkg="tf2_ros" type="static_transform_publisher" name="validation_world_to_map" args="0 0 0 0 0 0 world map" /><node pkg="tf2_ros" type="static_transform_publisher" name="validation_map_to_odom" args="0 0 0 0 0 0 map odom" /><node pkg="mm_gazebo" type="validation_io.py" name="validation_io" output="log" required="true"><param name="static_map_file" value="/home/l/remani_ws/experiments/gazebo_validation/runs/sync_01/static_map.npy" /></node><node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find mm_remani)/rviz/exp0_gazebo.rviz" /></launch>