+DynamicDetection frontFace(double x, int levels = 10)
+{
+  std::vector<Eigen::Vector3f> points;
+  for (int i = 0; i < levels; ++i)
+    for (double y : {-0.10, 0.10})
+      points.emplace_back(x, y, 0.20 + 0.06 * i);
+  return surfaceDetection(points);
+}
