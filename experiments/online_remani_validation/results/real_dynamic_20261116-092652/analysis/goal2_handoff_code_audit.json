  "confirmed_findings": [
    {
      "id": "sleep_activation_acceptance_conflict",
      "severity": "blocking",
      "statement": "Successful moving repairs with an existing trajectory cannot normally satisfy the subsequent 20ms activation-lead check: manager waits until activation if early, or activation has already passed if late, then FSM rejects.",
      "conditions": [
        "have_local_traj=true",
        "dynamic_repair=true",
        "guarded_dynamic_stop_handoff=false",
        "manager solver returns success",
        "no ROS time jump or interrupted sleep"
      ],
      "code_refs": [
        12,
        13,
        14
      ],
      "classification": "Direct conditional control-flow proof from inspected source; observed late-rejection logs are consistent."
    },
    {
      "id": "budget_is_optimizer_only",
      "statement": "The .60s parameter is the optimizer callback budget, not search+optimization+validation or total repair wall time. Search can use its own .45s plus frontend/refit/visualization; post-solve safety/statistics/wait and publication validation add more work. The source does not reserve end-to-end .020s acceptance lead.",
      "nominal_handoff_s": 0.7,
      "required_prevalidation_lead_s": 0.02,
      "nominal_available_until_lead_check_s": 0.68,
      "independent_search_plus_optimizer_caps_s": 1.05,
      "classification": "Direct source fact; caps are cooperative and not strict total bounds."
    },
    {
      "id": "why_reported_repairs_around_700ms",
      "statement": "DynamicLatency measures the whole call containing an explicit wait to a .70s activation time. Therefore 709.8/700.9/740.9ms does not prove 600ms optimizer overruns. All three log optimizer stopping-criteria success before late rejection; their exact search/optimization/sleep split was not recorded.",
      "optimizer_result_to_rejection_ms": [
        389.5890712738037,
        169.9666976928711,
        70.18065452575684
      ],
      "classification": "Observed timing plus code-consistent explanation; exact sleep duration unknown."
    },
    {
      "id": "single_queue_feedback_starvation_and_wallclock_fallback",
      "statement": "Synchronous planning and manager sleep hold the default FSM callback queue; its odom/progress callbacks cannot execute in that interval. A ~700ms operation exceeds .5s progress freshness and enables wall-clock phase/scale1 fallback when that cached progress is old.",
      "classification": "Queue blocking and fallback conditions proven by source; which exact progress predicate failed at this stop is not directly logged."
    }
  ],
