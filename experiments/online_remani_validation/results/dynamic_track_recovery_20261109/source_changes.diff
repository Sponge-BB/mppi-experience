+    EXPECT_TRUE(snapshot.points.front().position.isApprox(old_position));
+    EXPECT_EQ(now - ros::Duration(0.20), snapshot.stamp);
+    EXPECT_EQ("lost_observation", snapshot.invalid_reason);
+  }
