+
+void DynamicPointBuffer::recordObservation(
+    const DynamicPointSnapshot &candidate)
+{
+  if (received_observation_ && candidate.stamp < latest_input_stamp_)
+    return;
+  latest_input_stamp_ = candidate.stamp;
+  latest_observation_ = candidate;
+  received_observation_ = true;
+  if (candidate.has_track_ids && !history_overflow_)
+  {
+    std::unordered_map<std::uint32_t, DynamicPointVector> observed;
+    for (const auto &point : candidate.points)
+      observed[point.track_id].push_back(point);
+    std::size_t retained_points = 0;
+    for (const auto &track : track_history_)
+      if (!observed.count(track.first))
+        retained_points += track.second.observation.points.size();
+    const std::size_t budget = 4u * static_cast<std::size_t>(std::max(1, max_points_));
+    if (retained_points + candidate.points.size() > budget)
+      history_overflow_ = true;
+    else
+      for (auto &track : observed)
+      {
+        auto &history = track_history_[track.first];
+        history.observation.stamp = candidate.stamp;
+        history.observation.receive_time = candidate.receive_time;
+        history.observation.frame_id = candidate.frame_id;
+        history.observation.has_track_ids = history.observation.valid = true;
+        history.observation.points = std::move(track.second);
+        history.free_stamps = std::vector<ros::Time>();
+      }
+  }
+  refreshObservationSnapshot();
+}
+
+void DynamicPointBuffer::refreshObservationSnapshot()
+{
+  if (history_overflow_)
+  {
+    latest_snapshot_.valid = false;
+    latest_snapshot_.invalid_reason = "lost_observation";
+    return;
+  }
+  // Preserve the original fail-closed policy for unidentified old geometry.
+  if (!latest_snapshot_.points.empty() && !latest_snapshot_.has_track_ids)
+  {
+    latest_snapshot_ = applyObservation(latest_snapshot_, latest_observation_);
+    return;
+  }
+  std::unordered_set<std::uint32_t> observed_ids;
+  if (latest_observation_.has_track_ids)
+    for (const auto &point : latest_observation_.points)
+      observed_ids.insert(point.track_id);
+  const TrackObservation *oldest_missing = nullptr;
+  std::size_t missing_points = 0;
+  for (const auto &track : track_history_)
+    if (!observed_ids.count(track.first))
+    {
+      missing_points += track.second.observation.points.size();
+      if (!oldest_missing || track.second.observation.stamp <
+                                 oldest_missing->observation.stamp)
+        oldest_missing = &track.second;
+    }
+  if (!oldest_missing)
+  {
+    DynamicPointSnapshot accepted = latest_observation_;
+    accepted.sequence = latest_snapshot_.sequence + 1;
+    accepted.invalid_reason = accepted.points.empty() ? "no_dynamic_detected" : "";
+    latest_snapshot_ = std::move(accepted);
+    return;
+  }
+
+  // The public schema has a single timestamp. Expose one real source epoch
+  // and keep it invalid whenever other missing epochs exist; private history
+  // retains all IDs, including targets first seen during an earlier loss.
+  DynamicPointSnapshot held = oldest_missing->observation;
+  held.points.clear();
+  for (const auto &track : track_history_)
+    if (!observed_ids.count(track.first) &&
+        track.second.observation.stamp == held.stamp)
+      held.points.insert(held.points.end(), track.second.observation.points.begin(),
+                         track.second.observation.points.end());
+  held.sequence = latest_snapshot_.sequence +
+      (held.stamp != latest_snapshot_.stamp ||
+       held.points.size() != latest_snapshot_.points.size() ? 1 : 0);
+  held.valid = latest_snapshot_.valid && latest_observation_.points.empty() &&
+               held.stamp == latest_snapshot_.stamp &&
+               missing_points == held.points.size();
+  held.invalid_reason = held.valid ? "coasting_observation" : "lost_observation";
+  latest_snapshot_ = std::move(held);
+}
+
+std::size_t DynamicPointBuffer::recoverObservedTracks(
+    const ros::Time &stamp,
+    const std::function<bool(const Eigen::Vector3d &)> &observed_free,
+    const std::function<bool(const Eigen::Vector3d &)> &observed_occupied,
+    double map_resolution)
+{
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!enabled_ || !received_observation_ || history_overflow_ || !observed_free ||
+      stamp.isZero() || stamp <= last_recovery_stamp_ ||
+      latest_snapshot_.points.empty() || !latest_snapshot_.has_track_ids ||
+      !latest_observation_.has_track_ids ||
+      !std::isfinite(map_resolution) || map_resolution <= 0.0 ||
+      !std::isfinite(position_uncertainty_) || position_uncertainty_ < 0.0 ||
+      !checkSnapshotAge(latest_observation_, stamp, max_age_,
+                        future_stamp_tolerance_).valid)
+    return 0;
+
+  last_recovery_stamp_ = stamp;
+  std::unordered_set<std::uint32_t> observed_ids;
+  for (const auto &point : latest_observation_.points)
+    observed_ids.insert(point.track_id);
+
+  constexpr std::size_t proof_budget = 1000000;
+  const double requested_intervals = std::ceil(2.0 * position_uncertainty_ / map_resolution);
+  if (!std::isfinite(requested_intervals) || requested_intervals > 99.0)
+    return 0;
+  const std::size_t intervals = static_cast<std::size_t>(requested_intervals);
+  const std::size_t axis_samples = intervals + 1;
+  const std::size_t samples_per_point = axis_samples * axis_samples * axis_samples;
+  std::size_t missing_points = 0;
+  for (const auto &track : track_history_)
+    if (!observed_ids.count(track.first))
+      missing_points += track.second.observation.points.size();
+  if (missing_points > proof_budget / samples_per_point)
+    return 0;
+  if (map_resolution != recovery_resolution_)
+  {
+    for (auto &track : track_history_)
+      track.second.free_stamps = std::vector<ros::Time>();
+    recovery_resolution_ = map_resolution;
+  }
+
+  std::vector<std::uint32_t> cleared;
+  for (auto &track : track_history_)
+  {
+    auto &history = track.second;
+    if (observed_ids.count(track.first) || stamp <= history.observation.stamp)
+      continue;
+    if (history.free_stamps.size() != history.observation.points.size() * samples_per_point)
+      history.free_stamps.assign(history.observation.points.size() * samples_per_point, ros::Time(0));
+    bool track_free = true;
+    for (std::size_t i = 0; i < history.observation.points.size(); ++i)
+    {
+      const auto &point = history.observation.points[i];
+      std::size_t sample = 0;
+      for (std::size_t x = 0; x < axis_samples; ++x)
+        for (std::size_t y = 0; y < axis_samples; ++y)
+          for (std::size_t z = 0; z < axis_samples; ++z, ++sample)
+        {
+          const double step = intervals > 0 ? 2.0 * position_uncertainty_ / intervals : 0.0;
+          const Eigen::Vector3d position = point.position +
+              Eigen::Vector3d(step*x-position_uncertainty_,
+                              step*y-position_uncertainty_,
+                              step*z-position_uncertainty_);
+          ros::Time &free_stamp = history.free_stamps[i * samples_per_point + sample];
+          if (observed_occupied && observed_occupied(position))
+            free_stamp = ros::Time(0);
+          else if (observed_free(position))
+            free_stamp = stamp;
+          track_free = track_free && free_stamp > history.observation.stamp &&
+                       (stamp - free_stamp).toSec() <= max_age_;
+        }
+    }
+    if (track_free)
+      cleared.push_back(track.first);
+  }
+  if (cleared.empty())
+    return 0;
+  for (const auto id : cleared)
+    track_history_.erase(id);
+  ++latest_snapshot_.sequence;
+  refreshObservationSnapshot();
+  return cleared.size();
 }
 
