+TEST(GridMapOccupancy, NewEndpointHitRevokesOlderFreeRayEvidence)
+{
+  ensureRosInitialized();
+  GridMap map;
+  GridMapParallelTestAccessor::configureOccupancyUpdate(map);
+  const ros::Time now = ros::Time::now();
+  const Eigen::Vector3d first_surface(1.25, 0.75, 0.75);
+  const Eigen::Vector3d second_surface(1.25, 1.25, 0.75);
+  GridMapParallelTestAccessor::seedLostDynamicTrack(
+      map, first_surface, now - ros::Duration(0.10));
+  GridMapParallelTestAccessor::appendLostTrackSurface(map, second_surface);
+
+  // First scan covers only surface A. The target cannot be retired while B
+  // remains unseen, but A's recent ray evidence may be retained.
+  GridMapParallelTestAccessor::raycastTrackRecovery(
+      map, {Eigen::Vector3d(2.25, 0.75, 0.75)},
+      now - ros::Duration(0.10));
+  ASSERT_EQ(2U, map.getDynamicPointSnapshot(now).points.size());
+
+  // The next scan sees B free but hits A. Its hit must revoke A's old proof,
+  // rather than combining two incompatible scans into a false clear result.
+  GridMapParallelTestAccessor::raycastTrackRecovery(
+      map, {first_surface, Eigen::Vector3d(2.25, 1.75, 0.75)},
+      now - ros::Duration(0.05));
+  const auto blocked = map.getDynamicPointSnapshot(now);
+  EXPECT_FALSE(blocked.valid);
+  EXPECT_EQ(2U, blocked.points.size());
+  EXPECT_EQ("lost_observation", blocked.invalid_reason);
+
+  // A later complete free observation can still recover normally.
+  GridMapParallelTestAccessor::raycastTrackRecovery(
+      map, {Eigen::Vector3d(2.25, 0.75, 0.75),
+            Eigen::Vector3d(2.25, 1.75, 0.75)}, now);
+  const auto recovered = map.getDynamicPointSnapshot(now);
+  EXPECT_TRUE(recovered.valid);
+  EXPECT_TRUE(recovered.points.empty());
+}
