+TEST(DynamicPointBuffer, NewerFreshTrackerFrameDoesNotBlockOlderValidMapEvidence)
+{
+  plan_env::DynamicPointBuffer buffer;
+  DynamicPointBufferTestAccessor::feed(buffer, observation(90., {1}));
+  auto current = observation(100.15, {});
+  current.receive_time = timeFromSec(100.25);
+  DynamicPointBufferTestAccessor::feed(buffer, current);
+  EXPECT_EQ(DynamicPointBufferTestAccessor::recover(buffer, timeFromSec(100.),
+      [](const Eigen::Vector3d &) { return true; }), 1u);
+  EXPECT_TRUE(buffer.getSnapshot(timeFromSec(100.25)).valid);
+}
+
+TEST(DynamicPointBuffer, FutureTrackerSourceIsCheckedAgainstActualClock)
+{
+  plan_env::DynamicPointBuffer buffer;
+  DynamicPointBufferTestAccessor::feed(buffer, observation(90., {1}));
+  auto current = observation(100.40, {});
+  current.receive_time = timeFromSec(100.25);
+  DynamicPointBufferTestAccessor::feed(buffer, current);
+  bool queried = false;
+  EXPECT_EQ(DynamicPointBufferTestAccessor::recover(buffer, timeFromSec(100.20),
+      [&queried](const Eigen::Vector3d &) { queried = true; return true; }), 0u);
+  EXPECT_FALSE(queried);
+}
