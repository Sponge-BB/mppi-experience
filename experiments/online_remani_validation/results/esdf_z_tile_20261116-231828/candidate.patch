+
+// Experiment only: gather/scatter neighboring z-lines together while keeping
+// the native per-line double transform and arithmetic order unchanged.
+template <typename GetValue, typename SetValue>
+void fillDistanceTransformZTile(int length, int coordinate_offset, int lanes,
+                               const GetValue &get_value,
+                               const SetValue &set_value)
+{
+  thread_local std::vector<double> tile;
+  tile.resize(static_cast<std::size_t>(length) * lanes);
+  for (int coordinate = 0; coordinate < length; ++coordinate)
+    for (int lane = 0; lane < lanes; ++lane)
+      tile[static_cast<std::size_t>(lane) * length + coordinate] =
+          get_value(coordinate, lane);
+  for (int lane = 0; lane < lanes; ++lane)
+  {
+    const std::size_t begin = static_cast<std::size_t>(lane) * length;
+    fillDistanceTransform(length, coordinate_offset,
+        [&](int coordinate) { return tile[begin + coordinate]; },
+        [&](int coordinate, double value) { tile[begin + coordinate] = value; });
+  }
+  for (int coordinate = 0; coordinate < length; ++coordinate)
+    for (int lane = 0; lane < lanes; ++lane)
+      set_value(coordinate, lane,
+          tile[static_cast<std::size_t>(lane) * length + coordinate]);
 }
 
