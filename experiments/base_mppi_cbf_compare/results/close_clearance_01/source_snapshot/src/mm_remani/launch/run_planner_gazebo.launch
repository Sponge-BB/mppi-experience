<launch>
  <!-- Environment size configurations remain unchanged -->
  <arg name="map_size_x" value="15.0"/>
  <arg name="map_size_y" value="10.0"/>
  <arg name="map_size_z" value="3.0"/>
  <!-- Keep borrowing the parameter file directly from remani_planner without touching them -->
  <arg name="exp_param_file" default="$(find remani_planner)/config/exp0_param.yaml"/>

  <!-- Optional diagnostics.  Simulation keeps the historical defaults; the
       real-robot entry point disables consumers that are not needed for control. -->
  <arg name="enable_world_points" default="true"/>
  <arg name="enable_model_vis" default="true"/>
  <arg name="enable_heavy_visualization" default="true"/>
  <arg name="lidar_offset_x" default="0.28"/>
  <arg name="lidar_offset_y" default="0.0"/>
  <arg name="lidar_offset_z" default="0.002"/>

  <!-- =========================================================
       CRITICAL MAPPING: Real/Gazebo Sensors to Planner inputs
       ========================================================= -->
  <arg name="odom_topic"          value="/odom" />
  <arg name="joint_state_topic"   value="/mm/joint_states" />

  <!-- Filter Gazebo joint states from all joints to 6 arm joints to avoid memory corruption in planner -->
  <node name="filter_joint_states" pkg="mm_remani" type="filter_joint_states.py" output="screen" />


  <arg name="joint_cmd_topic"     value="/mm_controller_node/joint_cmd" />
  
  <!-- Map 3D Lidar pointcloud into absolute world frame -->
  <node if="$(arg enable_world_points)" name="velodyne_transformer" pkg="mm_remani" type="velodyne_transformer.py" output="screen">
    <param name="target_frame" value="world" />
    <remap from="~input" to="/velodyne_points" />
    <remap from="~output" to="/world_points" />
  </node>
  <arg name="cloud_topic"         value="/velodyne_points" />

  <arg name="gripper_cmd_topic"   value="/mm_controller_node/gripper_cmd"/>
  <arg name="gripper_state_topic" value="/mm/mani/gripper_state"/>

  <!-- =========================================================
       Start the Core Planner ONLY (No fake Simulator, No map Generator)
       ========================================================= -->
  <include file="$(find mm_remani)/launch/piper_advanced_param.xml">
    <arg name="map_size_x_"             value="$(arg map_size_x)"/>
    <arg name="map_size_y_"             value="$(arg map_size_y)"/>
    <arg name="map_size_z_"             value="$(arg map_size_z)"/>
    <arg name="exp_param_file"          value="$(arg exp_param_file)"/>
    
    <arg name="odometry_topic"          value="$(arg odom_topic)"/>
    <arg name="joint_state_topic"       value="$(arg joint_state_topic)"/>
    <arg name="joint_cmd_topic"         value="$(arg joint_cmd_topic)"/>
    <arg name="gripper_cmd_topic"       value="$(arg gripper_cmd_topic)"/>
    <arg name="gripper_state_topic"     value="$(arg gripper_state_topic)"/>
    <arg name="enable_model_vis"        value="$(arg enable_model_vis)"/>
    <arg name="enable_heavy_visualization" value="$(arg enable_heavy_visualization)"/>
    <arg name="lidar_offset_x"          value="$(arg lidar_offset_x)"/>
    <arg name="lidar_offset_y"          value="$(arg lidar_offset_y)"/>
    <arg name="lidar_offset_z"          value="$(arg lidar_offset_z)"/>
    
    <!-- Camera/depth info are preserved but cloud_topic takes precedence for environment -->
    <arg name="camera_pose_topic"       value="pcl_render_node/camera_pose"/>
    <arg name="depth_topic"             value="pcl_render_node/depth"/>
    <arg name="cloud_topic"             value="$(arg cloud_topic)"/>
    
    <arg name="cx" value="321.04638671875"/>
    <arg name="cy" value="243.44969177246094"/>
    <arg name="fx" value="387.229248046875"/>
    <arg name="fy" value="387.229248046875"/>
  </include>

  <!-- Bridge is already launched by display_mm_gazebo.launch -->

</launch>
