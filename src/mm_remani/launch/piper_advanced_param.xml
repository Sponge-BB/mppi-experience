<launch>
	<arg name="map_size_x_"/>
	<arg name="map_size_y_"/>
	<arg name="map_size_z_"/>

	<arg name="odometry_topic"/>
	<arg name="joint_state_topic"/>
	<arg name="gripper_state_topic"/>
	<arg name="joint_cmd_topic"/>
	<arg name="gripper_cmd_topic"/>
	<arg name="camera_pose_topic"/>
	<arg name="depth_topic"/>
	<arg name="cloud_topic"/>
	<arg name="exp_param_file"/>
	<arg name="enable_model_vis" default="true"/>
	<arg name="enable_heavy_visualization" default="true"/>
	<arg name="lidar_offset_x" default="0.28"/>
	<arg name="lidar_offset_y" default="0.0"/>
	<arg name="lidar_offset_z" default="0.002"/>

	<arg name="cx"/>
	<arg name="cy"/>
	<arg name="fx"/>
	<arg name="fy"/>
  
  <!-- main node -->
  	<node pkg="remani_planner" name="remani_planner_node" type="remani_planner_node" output="screen">
		<rosparam file="$(arg exp_param_file)"/>
		<rosparam file="$(find remani_planner)/config/piper_param.yaml"/>
		<rosparam file="$(find remani_planner)/config/remani_planner_param.yaml"/>

		<remap from="~gripper_cmd" to="$(arg gripper_cmd_topic)"/>
		<remap from="~gripper_state" to="$(arg gripper_state_topic)"/>
  
		<remap from="~odom_world" to="$(arg odometry_topic)"/>
		<remap from="~joint_state" to="$(arg joint_state_topic)"/>
		<remap from="~planning/trajectory" to = "planning/trajectory"/>
		<remap from="~planning/start" to = "planning/start"/>
		<remap from="~planning/finish" to = "planning/finish"/>
		<remap from="~planning/data_display" to = "planning/data_display"/>

		<remap from="~grid_map/odom"  to="$(arg odometry_topic)"/>
		<remap from="~grid_map/cloud" to="$(arg cloud_topic)"/>
		<remap from="~grid_map/pose"  to = "$(arg camera_pose_topic)"/> 
		<remap from="~grid_map/depth" to = "$(arg depth_topic)"/>
		<param name="visualization/enable_heavy" value="$(arg enable_heavy_visualization)" type="bool"/>
		
                <!-- planning fsm -->
                <param name="fsm/thresh_no_replan_meter"  value="1.0" type="double"/>
	                <param name="fsm/thresh_replan_time"      value="2.5" type="double"/>
		                <param name="fsm/replan_trajectory_time"  value="0.4" type="double"/>
		                <param name="fsm/dynamic_local_replan_enable" value="true" type="bool"/>
		                <param name="fsm/dynamic_replan_hold_arm" value="true" type="bool"/>
		                <param name="fsm/dynamic_replan_horizon" value="2.0" type="double"/>
		                <param name="fsm/dynamic_replan_handoff_time" value="0.30" type="double"/>
		                <param name="fsm/dynamic_astar_search_time" value="0.45" type="double"/>
		                <param name="fsm/dynamic_astar_replan_wall_time" value="0.60" type="double"/>
	                <param name="fsm/replan_feedback_position_threshold" value="0.08" type="double"/>
	                <param name="fsm/replan_feedback_yaw_threshold" value="0.15" type="double"/>
	                <param name="fsm/global_plan_dynamic_lookahead_distance" value="2.0" type="double"/>
	                <param name="fsm/global_plan_dynamic_far_sample_distance" value="0.10" type="double"/>
	                <param name="fsm/global_plan_dynamic_immediate_confirm_distance" value="1.0" type="double"/>
	                <param name="fsm/global_plan_dynamic_confirm_frames" value="2" type="int"/>
	                <param name="fsm/global_plan_dynamic_confirm_timeout" value="0.60" type="double"/>
	                <param name="fsm/global_plan_dynamic_clear_hold_time" value="0.40" type="double"/>
		                <param name="fsm/global_plan_dynamic_replan_hold_time" value="0.35" type="double"/>
	                <param name="fsm/global_plan_dynamic_same_obstacle_radius" value="0.45" type="double"/>
	                <param name="fsm/global_plan_dynamic_slowdown_distance" value="2.0" type="double"/>
	                <param name="fsm/global_plan_dynamic_slowdown_min_speed" value="0.08" type="double"/>
	                <param name="fsm/global_plan_dynamic_slowdown_max_speed" value="0.20" type="double"/>
	                <param name="fsm/global_plan_dynamic_emergency_deceleration" value="0.35" type="double"/>
	                <param name="fsm/global_plan_dynamic_emergency_reaction_time" value="0.15" type="double"/>
	                <param name="fsm/global_plan_dynamic_emergency_margin" value="0.05" type="double"/>
	                <param name="fsm/global_plan_dynamic_emergency_min_distance" value="0.15" type="double"/>
	                <param name="fsm/global_plan_dynamic_emergency_max_distance" value="0.22" type="double"/>
	                <param name="fsm/emergency_time"          value="0.8" type="double"/>
                <param name="fsm/fail_safe"               value="true"/>
                <param name="fsm/global_plan"             value="true" />
                <param name="search/max_seach_time"       value="0.9" type="double"/>
                <param name="search/visualize_search"     value="false" type="bool"/>
                <param name="grid_map/use_global_map"     value="true" />
                <param name="grid_map/fuse_global_map"    value="true" />
                <param name="grid_map/use_load_map"       value="true" />		<param name="grid_map/resolution"             value="0.05" /> 
		<param name="grid_map/map_size_x"             value="$(arg map_size_x_)" /> 
		<param name="grid_map/map_size_y"             value="$(arg map_size_y_)" /> 
		<param name="grid_map/map_size_z"             value="$(arg map_size_z_)" /> 
		<param name="grid_map/local_update_range_x"   value="8" />
		<param name="grid_map/local_update_range_y"   value="8" />
		<param name="grid_map/local_update_range_z"   value="3.0" /> 
				<param name="grid_map/obstacles_inflation"    value="0.0" /> 
		<param name="grid_map/local_map_margin"       value="15"/>
		<param name="grid_map/ground_height"          value="0.0"/>
		<param name="grid_map/z_length"               value="0.0"/>
		<param name="grid_map/self_filter_enable"     value="true"/>
		<param name="grid_map/self_filter_min_x"      value="-0.80"/>
		<param name="grid_map/self_filter_max_x"      value="0.45"/>
		<param name="grid_map/self_filter_min_y"      value="-0.85"/>
		<param name="grid_map/self_filter_max_y"      value="0.55"/>
		<param name="grid_map/self_filter_min_z"      value="-0.20"/>
		<param name="grid_map/self_filter_max_z"      value="0.90"/>
		<!-- Used only by GridMap's odometry fallback when an exact TF lookup
		     is temporarily unavailable. Keep it identical to the real LiDAR TF. -->
		<param name="grid_map/lidar_offset_x"          value="$(arg lidar_offset_x)"/>
		<param name="grid_map/lidar_offset_y"          value="$(arg lidar_offset_y)"/>
		<param name="grid_map/lidar_offset_z"          value="$(arg lidar_offset_z)"/>
		<!-- camera parameter -->
		<param name="grid_map/cx" value="$(arg cx)"/>
		<param name="grid_map/cy" value="$(arg cy)"/>
		<param name="grid_map/fx" value="$(arg fx)"/>
		<param name="grid_map/fy" value="$(arg fy)"/>
		<!-- depth filter -->
		<param name="grid_map/use_depth_filter"       value="true"/>
		<param name="grid_map/depth_filter_tolerance" value="0.15"/>
		<param name="grid_map/depth_filter_maxdist"   value="5.0"/>
		<param name="grid_map/depth_filter_mindist"   value="0.2"/>
		<param name="grid_map/depth_filter_margin"    value="2"/>
		<param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
		<param name="grid_map/skip_pixel"             value="2"/>
		<!-- local fusion -->
		<param name="grid_map/p_hit"  value="0.65"/>
		<param name="grid_map/p_miss" value="0.35"/>
		<param name="grid_map/p_min"  value="0.12"/>
		<param name="grid_map/p_max"  value="0.90"/>
		<param name="grid_map/p_occ"  value="0.80"/>
		<param name="grid_map/min_ray_length" value="0.1"/>
		<param name="grid_map/max_ray_length" value="4.5"/>
	
		<param name="grid_map/virtual_ceil_height"              value="4.0"/>
		<param name="grid_map/visualization_truncate_height"    value="2.8"/>
		<param name="grid_map/visualization_interval"           value="0.20"/>
		<param name="grid_map/esdf_visualization_stride"        value="2"/>
		<param name="grid_map/enable_visualization"             value="$(arg enable_heavy_visualization)" type="bool"/>
		<param name="grid_map/show_occ_time"                    value="false"/>
		<param name="grid_map/pose_type"                        value="2"/>  <!-- 2=ODOMETRY for LiDAR sync -->  
		<param name="grid_map/frame_id"                         value="world"/>

		<!-- sdf map -->
		<param name="grid_map/local_bound_inflate"              value="0.0"/>
		<param name="grid_map/local_esdf_follow_odom"           value="true"/>
		<param name="grid_map/global_map_full_esdf"             value="true"/>
		<param name="grid_map/global_map_obstacles_inflation"   value="0.0"/>
		<!-- The prebuilt PCD is a persistent collision layer. Live LiDAR is cleared separately. -->
		<param name="grid_map/global_map_lidar_clear"           value="false"/>
		<param name="grid_map/dynamic_static_match_radius"      value="0.075"/>
		<param name="grid_map/global_map_lidar_clear_radius"    value="0.0"/>
		<param name="grid_map/global_map_lidar_clear_min_misses" value="3"/>
		<param name="grid_map/show_esdf_time"                   value="false"/>
		<param name="grid_map/esdf_slice_height"                value="0.05"/>

		<!-- planner manager -->
		<param name="manager/control_points_distance"           value="0.4" type="double"/>
		<param name="manager/polyTraj_piece_length"             value="2.0" type="double"/>
		<param name="manager/feasibility_tolerance"             value="0.05" type="double"/>
  	</node>

	<node pkg="mm_controller" name="mm_controller_node" type="mm_controller_node" output="screen">
		<rosparam file="$(arg exp_param_file)"/>
		<rosparam file="$(find remani_planner)/config/piper_param.yaml"/>
		<rosparam file="$(find remani_planner)/config/remani_planner_param.yaml"/>
  
		<remap from="~odom" to="$(arg odometry_topic)"/>
		<remap from="~joint_states" to="$(arg joint_state_topic)"/>
		<remap from="~joint_cmd" to="$(arg joint_cmd_topic)"/>
		<remap from="~planning/trajectory" to = "planning/trajectory"/>
		<remap from="~planning/start" to = "planning/start"/>
		<remap from="~planning/finish" to = "planning/finish"/>
  	</node>

	<node if="$(arg enable_model_vis)" pkg="fake_mm" name="model_vis" type="model_vis" output="screen">
                <rosparam file="$(find remani_planner)/config/piper_param.yaml"/>
                <param name="publish_tf" value="false" />
                <remap from="~command" to="planning/pos_cmd"/>
                <remap from="~odometry" to="$(arg odometry_topic)"/>
                <remap from="~joint_cmd" to="$(arg joint_cmd_topic)"/>
                <remap from="~joint_state" to="$(arg joint_state_topic)"/>
                <remap from="~gripper_state" to="$(arg gripper_state_topic)"/>
        </node>
</launch>
