  <gazebo reference="joint1">
    <joint_properties damping="0.8" friction="0.2" />
  </gazebo>
  <gazebo reference="joint2">
    <joint_properties damping="0.6" friction="0.15" />
  </gazebo>
  <gazebo reference="joint3">
    <joint_properties damping="0.6" friction="0.15" />
  </gazebo>
  <gazebo reference="joint4">
    <joint_properties damping="0.4" friction="0.1" />
  </gazebo>
